# "desarrollo" o "produccion". En producción no se crean tablas
# automáticamente ni se expone la documentación interactiva.
ENTORNO=desarrollo

# Base de datos propia (MySQL): llaves de acceso y auditoría.
MYSQL_DATABASE_URL=mysql+pymysql://usuario:contrasena@host:3306/nombre_base
MYSQL_TIMEOUT_SEGUNDOS=10

# Fuente externa de solo lectura SQL Server - Prosoft, consumida vía VPN.
PROSOFT_DATABASE_URL=mssql+pymssql://usuario:contrasena@host:1433/nombre_base
PROSOFT_TIMEOUT_SEGUNDOS=10

# Carpeta donde se escriben los archivos de log de la aplicación.
DIRECTORIO_LOGS=logs

# Políticas de CORS por prefijo de ruta, como un único JSON en una línea.
# Vacío ({}) por defecto: sin esta variable, ningún origen de navegador
# puede leer las respuestas (las llamadas servidor-a-servidor como Power BI,
# otro backend o una automatización no se ven afectadas por esto, CORS solo
# aplica a navegadores). No se admite "*" como origen: cada dominio
# autorizado debe listarse explícitamente.
#
# Ejemplo con dos módulos, cada uno con su propio origen autorizado:
# CORS_POLITICAS={"/api/v1/integraciones/colaboradores": {"origenes": ["https://sga.zonalogistica.com.co"]}, "/api/v1/sga/transporte": {"origenes": ["https://sga.zonalogistica.com.co", "http://localhost:5173"], "metodos": ["GET", "POST"]}}
CORS_POLITICAS={}
